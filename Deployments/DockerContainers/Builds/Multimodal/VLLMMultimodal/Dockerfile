# --- Section: Dockerfile.header ---

# This Dockerfile is automatically generated by con(cat)enating textfiles.
#




# --- Section: Dockerfile.base ---

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Set the working directory in the container
# https://docs.docker.com/engine/reference/builder/
ENV THIRD_PARTY=/ThirdParty
WORKDIR /

## Update apt, pip, and do pip installs.
RUN apt-get update && \
  apt-get install --upgrade -y ccache && \
  python -m pip install --upgrade pip && \
  #
  #
  # Do more pip installs.
  # Reads key-value pairs from .env file to set environment variables; in
  # particular for Open AI API keys for LangChain.
  pip install --upgrade python-dotenv




# --- Section: Dockerfile.system_deps ---

# System libraries needed by:
#   - pdf2image (poppler-utils provides pdftoppm/pdftocairo used to rasterize PDFs)
#   - opencv / pillow image pipelines (libgl1, libglib2.0-0)
#   - headless rendering on a stripped container (libsm6, libxext6)
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
  && rm -rf /var/lib/apt/lists/*




# --- Section: Dockerfile.pytorch_reinstall ---

ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG NUMPY_VERSION

# The NVIDIA 25.06-py3 container ships torch 2.8.0a0+<sha> (a pre-release alpha
# tag). vLLM's wheel metadata pins a stable torch version (e.g. torch==2.8.0),
# and pip will refuse to use the container's alpha because alpha < stable in
# PEP 440 ordering. We reinstall to the stable wheel before installing vLLM.
#
# Same trick the NunchakuBased build uses; see its Dockerfile.pytorch_reinstall.
RUN sed -i '/^numpy==/d' /etc/pip/constraint.txt 2>/dev/null || true && \
    pip install --no-cache-dir numpy==${NUMPY_VERSION}

RUN sed -i '/^torch==/d' /etc/pip/constraint.txt 2>/dev/null || true && \
    sed -i '/^torchvision==/d' /etc/pip/constraint.txt 2>/dev/null || true && \
    pip install --no-cache-dir \
      torch==${TORCH_VERSION} \
      torchvision==${TORCHVISION_VERSION} \
      torchaudio

# The NV container ships flash-attn 2.7.4.post1 compiled against the alpha torch
# above. After torch is downgraded to stable, the prebuilt flash_attn_2_cuda.so
# fails to load with `undefined symbol: _ZN3c104cuda9SetDeviceEa` (libtorch C++
# ABI symbol). Rebuilding flash-attn against stable torch is a 30-min nvcc
# compile; uninstalling lets vLLM fall back to xformers (already present) for
# attention. Throughput drops modestly on long sequences; correctness is
# unaffected. If flash-attn becomes important later, reinstall it here with
# --no-build-isolation against the now-stable torch.
RUN pip uninstall -y flash-attn 2>&1 | tail -1

# /etc/pip/constraint.txt ships from the NV container with `nvidia-cudnn-frontend==1.12.0`.
# vLLM 0.11.1+ pulls in flashinfer-python==0.5.2 which requires
# nvidia-cudnn-frontend>=1.13.0; the constraint blocks the install with
# `ResolutionImpossible`. Strip the pin so flashinfer's bound wins. Same shape
# as the torch/numpy strips above. We're not the team that needs the cudnn
# frontend at 1.12.0 — that's a NV container assumption, not ours.
RUN sed -i '/^nvidia-cudnn-frontend==/d' /etc/pip/constraint.txt 2>/dev/null || true




# --- Section: Dockerfile.vllm ---

ARG VLLM_VERSION
ARG TRANSFORMERS_VERSION

# Install vLLM separately from mineru-vl-utils so the version is explicitly
# pinned and pip won't try to upgrade it later. mineru-vl-utils[vllm] only
# constrains vllm>=0.10.1.1,<0.12 — pinning here keeps the build reproducible.
RUN pip install --no-cache-dir vllm==${VLLM_VERSION}

# vLLM 0.11.0 declares transformers>=4.55.2 with no upper bound. transformers
# 5.x dropped legacy attributes (e.g. PreTrainedTokenizerBase.all_special_tokens_extended)
# that vLLM 0.11.0 still calls in get_cached_tokenizer, which raises
# `AttributeError: Qwen2Tokenizer has no attribute all_special_tokens_extended`
# at LLM(...) load time. Force-downgrade to the latest 4.x. mineru-vl-utils'
# transformers extra also caps at <5.0.0, so this matches the upstream intent.
RUN pip install --no-cache-dir transformers==${TRANSFORMERS_VERSION}

# Quick sanity check during build: import vllm so layer fails fast if there's
# a torch/CUDA ABI mismatch (rather than at first run).
RUN python -c "import vllm, transformers; \
  print(f'vLLM version: {vllm.__version__}'); \
  print(f'transformers version: {transformers.__version__}'); \
  assert transformers.__version__.startswith('4.'), 'transformers must be 4.x; vLLM <0.12 is incompatible with 5.x (mineru-vl-utils caps vLLM at <0.12)'"




# --- Section: Dockerfile.mineru ---

ARG MINERU_VL_UTILS_VERSION

# mineru-vl-utils provides MinerUClient (high-level extract API) and
# MinerULogitsProcessor (required to be passed to vllm.LLM(logits_processors=...)
# for vllm>=0.10.1).
#
# We install with the [vllm] extra purely so the metadata records the intended
# backend; vLLM itself is already installed from Dockerfile.vllm at a pinned
# version and pip will satisfy the (>=0.10.1.1,<0.12) constraint with the
# already-installed wheel.
RUN pip install --no-cache-dir \
  "mineru-vl-utils[vllm]==${MINERU_VL_UTILS_VERSION}"

# Sanity check: the imports we'll use from MoreMinerU.
RUN python -c "from mineru_vl_utils import MinerUClient, MinerULogitsProcessor; \
  print('mineru-vl-utils imports OK')"

# pdf2image is installed here (not in CommonComponents yet) because the runtime
# usage of this image always rasterizes PDFs before sending to MinerU.
# poppler-utils is installed at the system layer (Dockerfile.system_deps).
RUN pip install --no-cache-dir pdf2image




# --- Section: Dockerfile.qwen3vl ---

ARG QWEN_VL_UTILS_VERSION

# qwen-vl-utils provides `process_vision_info`, the canonical image / video
# preprocessing helper for the Qwen-VL family. The QwenLM/Qwen3-VL upstream
# README shows it as the recommended path for vLLM offline inference:
#     from qwen_vl_utils import process_vision_info
#     image_inputs, video_inputs = process_vision_info(messages)
#
# accelerate is co-installed because Qwen recommends it for the transformers-
# side helpers (notably AutoProcessor.from_pretrained on multi-shard checkpoints
# and any subsequent fine-tuning utilities).
#
# We don't git-clone QwenLM/Qwen3-VL into /ThirdParties because that repo is
# cookbooks + docs, not a Python package — everything we need at runtime is
# in this pip package.
RUN pip install --no-cache-dir \
  "qwen-vl-utils==${QWEN_VL_UTILS_VERSION}" \
  accelerate

# Sanity check the import that the wrapper actually uses.
RUN python -c "from qwen_vl_utils import process_vision_info; \
  print('qwen-vl-utils imports OK')"




# --- Section: Dockerfile.colqwen ---

ARG COLPALI_ENGINE_VERSION
ARG TRANSFORMERS_VERSION

# colpali-engine provides ColQwen2_5 + ColQwen2_5_Processor — the multi-vector
# retrieval model + scorer for `vidore/colqwen2.5-v0.2`. It's the upstream
# (Illuin Technology) reference library for ColPali / ColQwen models. Loading
# `ColQwen2_5.from_pretrained("vidore/colqwen2.5-v0.2", ...)` reads the LoRA's
# adapter_config.json and stitches it onto the base (`vidore/colqwen2.5-base`)
# automatically; transformers will fetch the base on first load if it's not
# already in the HF cache.
#
# Why not vLLM: ColQwen produces multi-vector ColBERT-style embeddings (one
# vector per image patch / text token) used with MaxSim scoring, not next-token
# generation. vLLM's API doesn't expose this surface. transformers direct is
# the right path.
# Install colpali-engine with `--no-deps`: its setup.py pins torch ~2.7 +
# CUDA 12.6 libs and (depending on version) transformers ranges that conflict
# with vLLM 0.11.2's torch 2.9 / transformers 4.57.6 stack. Without --no-deps
# pip silently downgrades torch + transformers + nvidia-cuda-* and the vLLM
# stack stops working. colpali-engine's runtime surface for ColQwen2_5
# (process_images, process_queries, model.forward, score_multi_vector) does
# not actually depend on those specific versions — it just lists them as
# tested. Install peft separately for LoRA loading; everything else
# (transformers, torch, pillow, etc.) is already in the image from earlier
# layers.
RUN pip install --no-deps --no-cache-dir \
  "colpali-engine==${COLPALI_ENGINE_VERSION}"

RUN pip install --no-cache-dir "peft>=0.10,<0.20" "GPUtil"

# The NV PyTorch container ships `torchao 0.11.0+git` (pre-release). peft 0.16+
# does a strict version check in `is_torchao_available()`: if torchao is
# importable but the version is < 0.16.0, it RAISES ImportError (instead of
# returning False, which would be the saner contract). We don't use torchao
# in our codepaths — uninstalling makes peft's check return False cleanly.
# If we ever need torchao, install >= 0.16.0 instead.
RUN pip uninstall -y torchao 2>&1 | tail -1

# Re-pin transformers in case anything above touched it, and to keep the
# final assert below crisp.
RUN pip install --no-cache-dir "transformers==${TRANSFORMERS_VERSION}"

# Final sanity check: confirm BOTH stacks are importable AND transformers is
# still 4.x. This is the assertion that catches future regressions where a
# new dep silently pulls transformers 5.x.
RUN python -c "import vllm, transformers; \
  from colpali_engine.models import ColQwen2_5, ColQwen2_5_Processor; \
  from mineru_vl_utils import MinerUClient; \
  from qwen_vl_utils import process_vision_info; \
  print(f'vLLM: {vllm.__version__}'); \
  print(f'transformers: {transformers.__version__}'); \
  print('all wrappers import OK'); \
  assert transformers.__version__.startswith('4.'), \
    f'transformers must stay 4.x (got {transformers.__version__}) — vLLM 0.11.2 incompat with 5.x'"


